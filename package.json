{
  "name": "wikipediabrown-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build && vite build --config booking/vite.config.ts && node scripts/prepare-apps-script.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.booking.json",
    "test": "node --test tests/*.test.cjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "playwright test",
    "dev:booking": "vite --config booking/vite.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.49.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.61.0",
    "bits-ui": "^2.20.2",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "marked": "^17.0.0",
    "shiki": "^3.20.0",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.3.1"
  }
}
